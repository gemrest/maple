compiler = clang++
compiler_flags = -std=c++20 -O2 -Weverything -Wno-padded -Wno-c++98-compat -Wno-c++98-compat-pedantic
build_directory = build

platform_warning_flags = $$(if test -f /etc/alpine-release; then $
    printf '%s ' '-Wno-disabled-macro-expansion'; $
  elif test "$$(uname -s)" = Darwin; then $
    case "$$($compiler --version)" in $
      ("Apple clang"*) $
        case "$$($compiler $compiler_flags -print-effective-triple)" in $
          ("$$(uname -m)"-apple-darwin*|"$$(uname -m)"-apple-macos*) $
            printf '%s ' '-Wno-poison-system-directories';; $
        esac;; $
    esac; $
  fi)

rule compile
  command = $compiler $compiler_flags $platform_warning_flags $$(pkg-config --cflags openssl | sed -E 's/(^| )-I/\1-isystem /g') -MMD -MF $out.d -c $in -o $out
  depfile = $out.d
  deps = gcc

rule link
  command = $compiler $in -o $out $$(pkg-config --libs openssl)

rule test
  command = python3 -m unittest discover -s tests -v
  pool = console

build $build_directory/maple.o: compile maple/maple.cc
build $build_directory/gemini.o: compile maple/gemini.cc
build $build_directory/titan.o: compile maple/titan.cc
build $build_directory/content.o: compile maple/content.cc
build $build_directory/connection.o: compile maple/connection.cc
build $build_directory/uri.o: compile maple/uri.cc
build $build_directory/maple: link $build_directory/maple.o $build_directory/gemini.o $build_directory/titan.o $build_directory/content.o $build_directory/connection.o $build_directory/uri.o
build check: test $build_directory/maple

default $build_directory/maple
