#!/usr/bin/env bash

set -euo pipefail
umask 077

if [[ -e .maple/private.pem || -L .maple/private.pem ||
      -e .maple/public.pem || -L .maple/public.pem ]]; then
  echo 'A certificate or key already exists in .maple; refusing to overwrite it.' >&2

  exit 1
fi

mkdir -p .maple/gmi
read -r -p 'Hostname for the Certificate: ' common_name
openssl req -new -x509 -newkey ec \
  -pkeyopt ec_paramgen_curve:prime256v1 \
  -subj "/CN=$common_name" -days 365 -nodes \
  -out .maple/public.pem -keyout .maple/private.pem
